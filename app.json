{
  "expo": {
    "name": "English Learning",
    "slug": "english-learning-mobile",
    "owner": "laxman99",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "englishapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.englishlearning.app",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb6d67a7-cafb-42c1-809f-267669c85f77"
      }
    }
  }
}
